# Used by docker-compose.yml. Copy to .env and fill in the values.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Optional: only needed for the OpenAI Realtime session route.
OPENAI_KEY=
# Optional: HTTPS proxy for GitHub API requests.
PROXY_URL=
# Strongly recommended on shared hosting: GitHub token (no scopes needed) to avoid the 60/hour API limit.
GITHUB_TOKEN=
# Public URL of the backend as seen from the browser.
BUN_PUBLIC_BACKEND_URL=http://localhost:3001
